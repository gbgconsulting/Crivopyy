# Copie para .env e ajuste os valores. Não commite o .env com segredos.

SECRET_KEY=sua-secret-key-segura-aqui
DEBUG=True
# Inclua o IP público da VM quando aceder pela Internet (Oracle/AWS/etc.).
ALLOWED_HOSTS=localhost,127.0.0.1,EXEMPLO.IP.PUBLICO
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://EXEMPLO.IP.PUBLICO:8000
SITE_URL=http://127.0.0.1:8000

# Docker Compose — PostgreSQL (make up): variáveis usadas pela service `db` e pelo Django.
# O docker-compose.yml força POSTGRES_HOST=db e POSTGRES_PORT=5432 no container da app web.
POSTGRES_DB=crivopy
POSTGRES_USER=crivopy
POSTGRES_PASSWORD=crivopy

# Gunicorn: 1/true = reinicia ao mudar código (1 worker); 0 = produção típica (2 workers, sem watcher)
GUNICORN_RELOAD=1

# Dados persistentes no container (mídia + Chroma)
# DATA_DIR=/app/data

# OpenAI
OPENAI_API_KEY=sk-proj-...
AGENT_MODEL=gpt-5.4-mini

# E-mail (Gmail)
EMAIL_HOST_USER=seuemail@gmail.com
EMAIL_HOST_PASSWORD=sua-senha-de-app-gmail
